{
  "__inputs": [],
  "__requires": [],
  "title": "Boost Gateway Production",
  "uid": "boost-gateway-production",
  "version": 4,
  "schemaVersion": 39,
  "tags": [
    "boost-gateway",
    "game-server",
    "production"
  ],
  "timezone": "utc",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "type": "datasource",
          "name": "Prometheus"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "title": "Gateway Up",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{job=\"gateway\"}",
          "legendFormat": "gateway"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "description": "Prometheus scrape status for gateway /metrics"
    },
    {
      "title": "Active Sessions",
      "type": "gauge",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "expr": "gateway_active_sessions",
          "legendFormat": "active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 10000,
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 7000
              },
              {
                "color": "red",
                "value": 9000
              }
            ]
          }
        }
      },
      "description": "Current active gateway TCP sessions"
    },
    {
      "title": "Accepted Sessions",
      "type": "timeseries",
      "gridPos": {
        "h": 5,
        "w": 7,
        "x": 9,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(gateway_accepted_sessions_total[1m])",
          "legendFormat": "accepted/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "description": "Accepted session rate exported by the production gateway"
    },
    {
      "title": "Outbound Dispatches",
      "type": "timeseries",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(gateway_outbound_dispatches_total[1m])",
          "legendFormat": "dispatches/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "description": "Responses and pushes dispatched by the v2 gateway runtime"
    },
    {
      "title": "Battle Route Queue",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "gateway_battle_route_queued_tasks",
          "legendFormat": "queued tasks"
        },
        {
          "expr": "gateway_battle_route_queue_capacity",
          "legendFormat": "queue capacity"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Current queued battle route work and configured queue capacity"
    },
    {
      "title": "Battle Route Rejections",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "expr": "rate(gateway_battle_route_rejected_tasks_total[5m])",
          "legendFormat": "rejected/s"
        },
        {
          "expr": "rate(gateway_battle_route_dropped_completions_total[5m])",
          "legendFormat": "dropped completions/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "eps"
        }
      },
      "description": "Battle route work rejected at admission or dropped during completion"
    },
    {
      "title": "Backend Requests",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "targets": [
        {
          "expr": "rate(gateway_backend_login_requests_total[1m])",
          "legendFormat": "login requests/s"
        },
        {
          "expr": "rate(gateway_backend_room_requests_total[1m])",
          "legendFormat": "room requests/s"
        },
        {
          "expr": "rate(gateway_backend_battle_requests_total[1m])",
          "legendFormat": "battle requests/s"
        },
        {
          "expr": "rate(gateway_backend_matchmaking_requests_total[1m])",
          "legendFormat": "matchmaking requests/s"
        },
        {
          "expr": "rate(gateway_backend_leaderboard_requests_total[1m])",
          "legendFormat": "leaderboard requests/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps"
        }
      },
      "description": "Gateway-observed request rates for every production backend"
    },
    {
      "title": "Backend Errors / Timeouts",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "expr": "rate(gateway_backend_login_errors_total[5m]) + rate(gateway_backend_login_timeouts_total[5m])",
          "legendFormat": "login failures/s"
        },
        {
          "expr": "rate(gateway_backend_room_errors_total[5m]) + rate(gateway_backend_room_timeouts_total[5m])",
          "legendFormat": "room failures/s"
        },
        {
          "expr": "rate(gateway_backend_battle_errors_total[5m]) + rate(gateway_backend_battle_timeouts_total[5m])",
          "legendFormat": "battle failures/s"
        },
        {
          "expr": "rate(gateway_backend_matchmaking_errors_total[5m]) + rate(gateway_backend_matchmaking_timeouts_total[5m])",
          "legendFormat": "matchmaking failures/s"
        },
        {
          "expr": "rate(gateway_backend_leaderboard_errors_total[5m]) + rate(gateway_backend_leaderboard_timeouts_total[5m])",
          "legendFormat": "leaderboard failures/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "eps"
        }
      },
      "description": "Gateway RED counters for backend route errors and timeouts"
    },
    {
      "title": "Backend Route Latency P99",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "expr": "gateway_backend_login_p99_latency_us / 1000",
          "legendFormat": "login p99 ms"
        },
        {
          "expr": "gateway_backend_room_p99_latency_us / 1000",
          "legendFormat": "room p99 ms"
        },
        {
          "expr": "gateway_backend_battle_p99_latency_us / 1000",
          "legendFormat": "battle p99 ms"
        },
        {
          "expr": "gateway_backend_matchmaking_p99_latency_us / 1000",
          "legendFormat": "matchmaking p99 ms"
        },
        {
          "expr": "gateway_backend_leaderboard_p99_latency_us / 1000",
          "legendFormat": "leaderboard p99 ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "description": "Backend route latency P99 upper-bound gauges exported by the v2 gateway. Use the histogram bucket metric for percentile calculations over longer windows."
    },
    {
      "title": "Backend Route Latency Histogram",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (exported_service, le) (rate(gateway_backend_route_latency_us_bucket[5m]))) / 1000",
          "legendFormat": "{{exported_service}} p99 ms"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (exported_service, le) (rate(gateway_backend_route_latency_us_bucket[5m]))) / 1000",
          "legendFormat": "{{exported_service}} p90 ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "description": "Prometheus histogram_quantile view of gateway-observed backend route latency. Empty until route traffic produces bucket samples."
    },
    {
      "title": "Backend Successes",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "expr": "rate(gateway_backend_login_successes_total[5m])",
          "legendFormat": "login successes/s"
        },
        {
          "expr": "rate(gateway_backend_room_successes_total[5m])",
          "legendFormat": "room successes/s"
        },
        {
          "expr": "rate(gateway_backend_battle_successes_total[5m])",
          "legendFormat": "battle successes/s"
        },
        {
          "expr": "rate(gateway_backend_matchmaking_successes_total[5m])",
          "legendFormat": "matchmaking successes/s"
        },
        {
          "expr": "rate(gateway_backend_leaderboard_successes_total[5m])",
          "legendFormat": "leaderboard successes/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "description": "Gateway-observed successful responses from every production backend. This is a backend RED signal, not an end-to-end business SLI."
    },
    {
      "title": "Leaderboard / Redis Dependent Errors",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "expr": "rate(gateway_backend_leaderboard_errors_total[5m])",
          "legendFormat": "leaderboard errors/s"
        },
        {
          "expr": "rate(gateway_backend_leaderboard_timeouts_total[5m])",
          "legendFormat": "leaderboard timeouts/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "eps"
        }
      },
      "description": "Current Redis degradation signal is inferred through leaderboard backend route failures"
    },
    {
      "title": "Battle Route Totals",
      "type": "timeseries",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "gateway_battle_route_rejected_tasks_total",
          "legendFormat": "rejected tasks"
        },
        {
          "expr": "gateway_battle_route_dropped_completions_total",
          "legendFormat": "dropped completions"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Cumulative battle route rejection and dropped-completion counters"
    },
    {
      "title": "Battle Route State",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 23
      },
      "targets": [
        {
          "expr": "gateway_battle_route_queued_tasks",
          "legendFormat": "queued tasks"
        },
        {
          "expr": "gateway_battle_route_queue_capacity",
          "legendFormat": "queue capacity"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Current battle route queue depth and capacity"
    },
    {
      "title": "Optional Process Exporter",
      "type": "timeseries",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 23
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"gateway\"}",
          "legendFormat": "rss"
        },
        {
          "expr": "process_open_fds{job=\"gateway\"}",
          "legendFormat": "open fds"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Optional process exporter metrics. Empty until a process exporter target is added."
    },
    {
      "title": "Redis Runtime",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "redis_connected_clients",
          "legendFormat": "connected clients"
        },
        {
          "expr": "rate(redis_commands_processed_total[1m])",
          "legendFormat": "commands/s"
        },
        {
          "expr": "redis_keyspace_hits_total",
          "legendFormat": "hits total"
        },
        {
          "expr": "redis_keyspace_misses_total",
          "legendFormat": "misses total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Redis exporter metrics for runtime visibility"
    },
    {
      "title": "Redis Memory",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "used bytes"
        },
        {
          "expr": "redis_config_maxmemory",
          "legendFormat": "configured maxmemory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "description": "Redis memory usage and configured cap"
    },
    {
      "title": "Container Runtime",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "expr": "sum by (container) (container_memory_working_set_bytes * on (id) group_left (container) boost_gateway_container_info)",
          "legendFormat": "{{container}} memory"
        },
        {
          "expr": "sum by (container) (rate(container_cpu_usage_seconds_total[5m]) * on (id) group_left (container) boost_gateway_container_info)",
          "legendFormat": "{{container}} cpu/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Governed cAdvisor container CPU and working-set metrics"
    },
    {
      "title": "Host CPU / Load / Memory",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "cpu used ratio"
        },
        {
          "expr": "node_load1 / count without (cpu, mode) (node_cpu_seconds_total{mode=\"idle\"})",
          "legendFormat": "load1 per cpu"
        },
        {
          "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
          "legendFormat": "memory used ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "description": "Node exporter host saturation signals"
    },
    {
      "title": "Host Filesystem / Disk I/O",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"}",
          "legendFormat": "{{mountpoint}} available ratio"
        },
        {
          "expr": "sum by (device) (rate(node_disk_read_bytes_total[5m]))",
          "legendFormat": "{{device}} read B/s"
        },
        {
          "expr": "sum by (device) (rate(node_disk_written_bytes_total[5m]))",
          "legendFormat": "{{device}} write B/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Persistent filesystem capacity and block-device throughput"
    },
    {
      "title": "Host Network / Thermal",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 46
      },
      "targets": [
        {
          "expr": "sum by (device) (rate(node_network_receive_bytes_total{device!=\"lo\"}[5m]))",
          "legendFormat": "{{device}} receive B/s"
        },
        {
          "expr": "sum by (device) (rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m]))",
          "legendFormat": "{{device}} transmit B/s"
        },
        {
          "expr": "node_hwmon_temp_celsius or node_thermal_zone_temp",
          "legendFormat": "{{chip}} {{sensor}} {{zone}} temperature"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Host network throughput and available hwmon or thermal-zone sensors"
    },
    {
      "title": "Container Starts / Restarts",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 46
      },
      "targets": [
        {
          "expr": "container_start_time_seconds * on (id) group_left (container) boost_gateway_container_info",
          "legendFormat": "{{container}} start time"
        },
        {
          "expr": "boost_gateway_container_restart_count",
          "legendFormat": "{{container}} restart count"
        },
        {
          "expr": "boost_gateway_container_restart_collection_success",
          "legendFormat": "restart collector success"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Container start timestamps and detected changes from cAdvisor"
    },
    {
      "title": "Redis Persistence Health",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "targets": [
        {
          "expr": "redis_rdb_last_bgsave_status",
          "legendFormat": "last background save status"
        },
        {
          "expr": "redis_rdb_changes_since_last_save",
          "legendFormat": "changes since save"
        },
        {
          "expr": "time() - redis_rdb_last_save_timestamp_seconds",
          "legendFormat": "seconds since save"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Read-only observation of the active Redis RDB persistence state"
    }
  ]
}
