[Unit]
Description=Apply bounded retention to the off-host BoostGateway backup vault
After=local-fs.target

[Service]
Type=oneshot
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /usr/local/libexec/boost-gateway-vault/scripts/tools/run_backup_vault_retention.py --vault-root /srv/boost-gateway-vault --policy /usr/local/libexec/boost-gateway-vault/deploy/operations/aliyun-backup-vault-retention-policy.json
User=boost-gateway-vault
Group=boost-gateway-vault
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ProtectProc=invisible
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/srv/boost-gateway-vault
ReadOnlyPaths=/srv/boost-gateway-vault/.vault-identity
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
