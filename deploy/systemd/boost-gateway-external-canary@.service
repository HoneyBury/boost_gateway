[Unit]
Description=BoostGateway external business canary (%i)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/boost-gateway-canary/environment
ConditionPathExists=/etc/boost-gateway-canary/deployment-record.json

[Service]
Type=oneshot
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/boost-gateway-canary/environment
ExecStart=/opt/boost-gateway-canary/venv/bin/python /usr/local/libexec/boost-gateway-canary/external_business_canary.py %i
User=boost-gateway-canary
Group=boost-gateway-canary
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ProtectProc=invisible
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/boost-gateway-canary
TimeoutStartSec=50s
