[Unit]
Description=Detect silent external BoostGateway canary failure
Wants=boost-gateway-canary-alertmanager-forward.service
After=boost-gateway-canary-alertmanager-forward.service

[Timer]
OnCalendar=*-*-* *:*:45 UTC
Persistent=true
AccuracySec=1s
Unit=boost-gateway-external-canary@watchdog.service

[Install]
WantedBy=timers.target
