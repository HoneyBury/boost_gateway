[Unit]
Description=Create one encrypted off-host BoostGateway backup
After=network-online.target docker.service boost-gateway-compose.service
Wants=network-online.target
ConditionPathExists=/opt/boost-gateway/current/record.json
ConditionPathExists=/etc/boost-gateway/backup-remote-host

[Service]
Type=oneshot
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /usr/local/libexec/boost-gateway/backup/scripts/tools/run_scheduled_backup.py
User=root
Group=boost-gateway
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ProtectProc=invisible
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/backups/boost-gateway
ReadWritePaths=/var/lib/boost-gateway-evidence/recovery
ReadWritePaths=/var/lib/boost-gateway/deployment-transactions
TimeoutStartSec=90min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
