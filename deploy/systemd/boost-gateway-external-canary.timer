[Unit]
Description=Run the external BoostGateway business canary every minute
Wants=boost-gateway-canary-alertmanager-forward.service
After=boost-gateway-canary-alertmanager-forward.service

[Timer]
OnCalendar=*-*-* *:*:00 UTC
Persistent=true
AccuracySec=1s
Unit=boost-gateway-external-canary@run.service

[Install]
WantedBy=timers.target
